# =============================
# Maven / Java Build Artifacts
# =============================
target/
*.class
*.jar
*.war
*.ear
*.log

# =============================
# IDE
# =============================
.idea/
*.iml
.vscode/settings.json          # user-specific settings only
*.code-workspace

# =============================
# Extracted output (generated by the tool itself)
# =============================
extracted_output/

# =============================
# Documentation files (input data, not source code)
# =============================
*.docx
*.doc
*.xlsx
*.xls
*.pdf
*.zip
*.pptx
*.ppt

# =============================
# AI Agent artifacts (auto-generated, do not commit)
# =============================
.cursor/
.claued/                     # if using Claude Code local mode
.openai/
copilot-instructions.md.bak

# =============================
# OS / Editor temp files
# =============================
.DS_Store
Thumbs.db
*.swp
*~

# =============================
# Jacoco coverage reports
# =============================
jacoco.exec
**/site/jacoco/
